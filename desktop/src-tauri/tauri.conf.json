{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MM Electricals",
  "version": "0.1.0",
  "identifier": "com.mmelectricals.shopmanager",
  "build": {
    "frontendDist": "../splash",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev --prefix ../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MM Electricals",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "api-bundle/": "api/"
    },
    "publisher": "MM Electricals",
    "shortDescription": "MM Electricals shop manager",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
